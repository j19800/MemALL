scratch/

# Generated memory dumps (per-agent exports, regenerated on demand)
_memory_export/

# ── One-off investigation scripts and their dumps ──
# These are probes written against the live DB during a specific session
# (query_*.py, create_goal_*.py). They are not tooling and must not ship:
# a script named create_goal_*.py sitting next to real source is
# indistinguishable from a supported tool to the next reader.
.tmp-*.py
.tmp_*.py
.tmp-*.md
query_*.py
create_goal_*.py
search_goal.py
check_dbs.py
test_import.py
goal_*_decompose.*
goal_decompose.json
decompose_*.json

