# Scratch scripts use a __name prefix, but Python's __init__.py does too.
# Without the negation every package marker is ignored and a clone cannot
# import the package at all.
__*.py
!__init__.py
!**/__init__.py
__*.ps1
__*.md
_*.ps1
_*.cmd
!__init__.py
__deep_data.json
conversations/
*.db
*.jsonl

